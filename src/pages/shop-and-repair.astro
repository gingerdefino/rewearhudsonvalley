---
import BaseLayout from '../layouts/BaseLayout.astro';

const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Hudson Valley Sustainable Fashion Map"
  instagramFollow={{
    heading: 'Stay in the loop!',
    description: 'Follow Re:Wear on Instagram to be notified of events, workshops and news surrounding sustainable fashion in the Hudson Valley Community.',
    buttonLabel: 'Follow Re:Wear on Instagram',
    buttonHref: 'https://www.instagram.com/rewearhudsonvalley/',
    imageSrc: withBase('/insta-follow-08.png'),
    imageAlt: 'Instagram follow graphic showing Re:Wear Hudson Valley with a clothing rack collage',
  }}
>
  <section class="section">
    <div class="section-inner">
      <h1>Hudson Valley Sustainable Fashion Map</h1>
      <p>
        From thrift stores to repair shops, find everything you need to shop consciously.
      </p>

      <iframe
        class="embed-frame"
        src="https://example.com" 
        title="Directory of sustainable fashion shops and repair services"
        loading="lazy">
        <p>
          Your browser does not support iframes. You can access the directory directly at
          <a href="https://example.com">this link</a>.
        </p>
      </iframe>
    </div>
  </section>
</BaseLayout>
