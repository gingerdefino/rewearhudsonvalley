---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalResourceCard from '../components/LocalResourceCard.astro';

const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Community Spotlight"
  instagramFollow={{
    heading: 'Stay in the loop!',
    description: 'Follow Re:Wear on Instagram to be notified of events, workshops and news surrounding sustainable fashion in the Hudson Valley Community.',
    buttonLabel: 'Follow Re:Wear on Instagram',
    buttonHref: 'https://www.instagram.com/rewearhudsonvalley/',
    imageSrc: withBase('/insta-follow-07.png'),
    imageAlt: 'Instagram follow graphic showing Re:Wear Hudson Valley with a shoes collage',
  }}
>
  <section class="section" aria-labelledby="resources-heading">
    <div class="section-inner">
      <h1 id="resources-heading">Community Spotlight</h1>
      <p>
        Find workshops, events, and local organizations championing sustainable fashion.
      </p>

      <ul class="resource-list">
        <li>
          <LocalResourceCard
            title="HV Sustainable Fashion Week"
            img={withBase('/hvsfw.jpg')}
            alt="Hudson Valley Sustainable Fashion Week"
            href="https://www.hvsfw.org/"
            tags={["Event", "Fashion", "Community"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Made X Hudson"
            img={withBase('/madexhudson.jpg')}
            alt="Made X Hudson"
            href="https://madexhudson.com/"
            tags={["Marketplace", "Local Makers", "Sustainable Goods"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Faithfully Yours"
            img={withBase('/faithfullyyours.png')}
            alt="Faithfully Yours"
            href="https://www.faithfullyyoursatelier.com/"
            tags={["Alterations", "Tailoring", "Atelier"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Katrina Rodabaugh"
            img={withBase('/katarina.jpg')}
            alt="Katrina Rodabaugh"
            href="https://www.katrinarodabaugh.com/"
            tags={["Visible Mending", "Textile Artist", "Education"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Hudson Valley Stitch Witch"
            img={withBase('/hvstitchwitch.png')}
            alt="Hudson Valley Stitch Witch"
            href="https://www.hvstitchwitch.com/"
            tags={["Alterations", "Mending", "Sewing"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Repair Café Hudson Valley"
            img={withBase('/repaircafe.jpg')}
            alt="Repair Café Hudson Valley"
            href="https://repaircafe.org/"
            tags={["Repair Events", "Volunteer", "Circular Economy"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Trans Closet of the Hudson Valley"
            img={withBase('/rethreads.jpg')}
            alt="ReThreads Hudson Valley"
            href="#"
            tags={["Clothing Access", "LGBTQ+", "Mutual Aid"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Hudson Valley Textile Lab"
            img={withBase('/textilelab.jpg')}
            alt="Hudson Valley Textile Lab"
            href="#"
            tags={["Workshops", "Natural Dye", "Textiles"]}
          />
        </li>

        <li>
          <LocalResourceCard
            title="Stitch & Sip Poughkeepsie"
            img={withBase('/stitchsip.jpg')}
            alt="Stitch and Sip Poughkeepsie"
            href="#"
            tags={["Social Sewing", "Beginner Friendly", "Community"]}
          />
        </li>
      </ul>
    </div>
  </section>

</BaseLayout>
