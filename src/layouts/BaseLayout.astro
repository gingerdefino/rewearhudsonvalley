---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstagramFollowSection from '../components/InstagramFollowSection.astro';

interface Props {
  title: string;
  instagramFollow?: {
    heading: string;
    description: string;
    buttonLabel: string;
    buttonHref: string;
    imageSrc: string;
    imageAlt: string;
  };
}

const { title, instagramFollow } = Astro.props as Props;
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Re-Wear Hudson Valley</title>
  <link rel="icon" type="image/x-icon" href={withBase('/favicon.png')}>
  <link rel="stylesheet" href="https://use.typekit.net/wwh7hjk.css">
</head>
<body>
  <div class="page">
    <Header />
    <main>
      <slot />
      {instagramFollow && <InstagramFollowSection {...instagramFollow} />}
    </main>
    <Footer />
  </div>
</body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
