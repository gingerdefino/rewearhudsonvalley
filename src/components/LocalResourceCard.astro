---
const { title, img, alt, tags = [], href } = Astro.props;
const isExternal = typeof href === 'string' && /^https?:\/\//.test(href);
---

<article class="card">
  <img src={img} alt={alt} class="card-image" />
  <h3>{title}</h3>
  <div class="tag-container">
    {tags.map(tag => (
      <span class="tag">{tag}</span>
    ))}
  </div>
  <a href={href} class="button small" target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>Visit Site</a>
</article>
