---
interface Props {
  heading: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  imageSrc: string;
  imageAlt: string;
}

const {
  heading,
  description,
  buttonLabel,
  buttonHref,
  imageSrc,
  imageAlt,
} = Astro.props as Props;
---

<section class="instagram-follow section" aria-labelledby="instagram-follow-heading">
  <div class="instagram-follow__inner section-inner">
    <div class="instagram-follow__visual">
      <img src={imageSrc} alt={imageAlt} class="instagram-follow__image">
    </div>

    <div class="instagram-follow__content">
      <h2 id="instagram-follow-heading">{heading}</h2>
      <p>{description}</p>
      <a class="instagram-follow__button" href={buttonHref} target="_blank" rel="noopener noreferrer">
        {buttonLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .instagram-follow {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(2.25rem, 5vw, 4.5rem);
  }

  .instagram-follow__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .instagram-follow__visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .instagram-follow__image {
    width: min(100%, 38rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(39, 28, 20, 0.16));
  }

  .instagram-follow__content {
    max-width: 34rem;
  }

  .instagram-follow__content h2 {
    margin-bottom: 1rem;
    font-size: clamp(2.25rem, 4vw, 3.1rem);
    letter-spacing: -0.03em;
  }

  .instagram-follow__content p {
    margin-bottom: 1.75rem;
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .instagram-follow__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.35rem;
    margin-bottom: 2rem;
    align-self: center;
    min-width: min(100%, 21rem);
    padding: 1.25rem 1.6rem 1.25rem;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-text-light);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.1;
    box-shadow: 0 10px 0 rgba(50, 34, 120, 0.16);
    transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }

  .instagram-follow__button:hover,
  .instagram-follow__button:focus-visible {
    background: var(--color-primary-warm);
    color: var(--color-text-light);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .instagram-follow__inner {
      grid-template-columns: 1fr;
    }

    .instagram-follow__content {
      max-width: 42rem;
      margin-inline: auto;
      text-align: left;
    }

    .instagram-follow__visual {
      order: 0;
    }

    .instagram-follow__content {
      order: 1;
    }
  }

  @media (max-width: 540px) {
    .instagram-follow {
      padding-top: 1.5rem;
      padding-bottom: 3rem;
    }

    .instagram-follow__content p {
      font-size: 1rem;
    }

    .instagram-follow__button {
      width: 100%;
      min-width: 0;
      padding-block: 1.4rem;
    }
  }
</style>