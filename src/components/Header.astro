---
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<header class="site-header">
  <div class="header-inner">
    <a href={withBase('/')} class="site-logo">
      <img src={withBase('/rewear-logo.png')} alt="Re-Wear Logo" class="logo-img">
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="site-nav">
      <ul>
        <li><a href={withBase('/shop-and-repair')}>Shop & Repair</a></li>
        <li><a href={withBase('/local-resources')}>Local Resources</a></li>
        <li><a href={withBase('/about')}>About</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const navToggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.site-nav');

  if (navToggle && nav) {
    navToggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      navToggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
